<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <!-- Transparent background -->
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
        </shape>
    </item>

    <item
        android:bottom="2.00dp"
        android:left="0dp"
        android:right="0dp"
        android:top="38.00dp"> <!-- 40dp height minus 1.00dp line -->
        <shape android:shape="rectangle">
            <solid android:color="#494545" />
        </shape>
    </item>
</layer-list>