<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="320dp"
    android:layout_height="230dp"
    app:cardElevation="10dp"
    app:cardCornerRadius="16dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- Exclamation Mark Icon Image -->
        <ImageView
            android:id="@+id/image_view_exclamation_mark"
            android:layout_width="28dp"
            android:layout_height="32dp"
            android:layout_marginTop="25dp"
            android:contentDescription="@string/image_view_exclamation_mark"
            android:src="@drawable/dialog_box_exclamation_mark"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />


        <!-- Heading/Title -->
        <TextView
            android:id="@+id/discard_password_change_lbl"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/discard_password_change_lbl"
            android:textAppearance="@style/dialog_box_headings"
            app:layout_constraintEnd_toEndOf="@+id/image_view_exclamation_mark"
            app:layout_constraintStart_toStartOf="@+id/image_view_exclamation_mark"
            app:layout_constraintTop_toBottomOf="@+id/image_view_exclamation_mark" />

        <!-- Subheading/Note -->
        <TextView
            android:id="@+id/discard_password_change_note"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="0dp"
            android:text="@string/discard_password_change_note"
            android:textAlignment="center"
            android:textAppearance="@style/dialog_box_subheadings"
            app:layout_constraintEnd_toEndOf="@+id/discard_password_change_lbl"
            app:layout_constraintStart_toStartOf="@+id/discard_password_change_lbl"
            app:layout_constraintTop_toBottomOf="@+id/discard_password_change_lbl" />


        <!-- Buttons -->
        <!-- Discard Change Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/discard_change_btn"
            android:layout_width="130dp"
            android:layout_height="50dp"
            android:layout_marginTop="25dp"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="175dp"
            android:backgroundTint="@color/red"
            app:cornerRadius="4dp"
            app:layout_constraintStart_toStartOf="@+id/discard_password_change_note"
            app:layout_constraintEnd_toEndOf="@+id/discard_password_change_note"
            app:layout_constraintTop_toBottomOf="@+id/discard_password_change_note"
            android:text="@string/discard_change_btn"
            android:paddingLeft="10dp"
            android:paddingRight="10dp"
            android:textSize="12sp"
            android:letterSpacing="-0.04"
            android:textColor="@color/white"
            android:fontFamily="@font/poppins_regular" />

        <!-- Go Back Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/go_back_btn"
            android:layout_width="130dp"
            android:layout_height="50dp"
            android:layout_marginTop="25dp"
            android:layout_marginStart="170dp"
            android:layout_marginEnd="20dp"
            android:backgroundTint="@color/white"
            app:cornerRadius="4dp"
            app:layout_constraintStart_toStartOf="@+id/discard_password_change_note"
            app:layout_constraintEnd_toEndOf="@+id/discard_password_change_note"
            app:layout_constraintTop_toBottomOf="@+id/discard_password_change_note"
            android:text="@string/go_back_btn"
            android:paddingLeft="10dp"
            android:paddingRight="10dp"
            android:textSize="12sp"
            android:letterSpacing="-0.04"
            android:textColor="@color/light_brown"
            android:fontFamily="@font/poppins_regular"
            app:strokeColor="@color/light_brown"
            app:strokeWidth="3dp"/>

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.cardview.widget.CardView>