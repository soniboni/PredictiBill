<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ui.profile.ProfileFragment">


    <!-- Logo Image -->
    <ImageView
        android:id="@+id/Logo"
        android:layout_width="300dp"
        android:layout_height="40dp"
        android:paddingStart="14dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.468"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.092"
        app:srcCompat="@drawable/logo_icontext_blue" />


    <!--  Heading - Title -->
    <TextView
        android:id="@+id/profile_change_password_lbl"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintVertical_bias="0.160"
        app:layout_constraintHorizontal_bias="0.50"
        android:text="@string/profile_change_password_lbl"
        android:textAppearance="@style/headings" />

    <!-- Subheading - The password must be... -->
    <TextView
        android:id="@+id/profile_the_password_must_lbl"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintVertical_bias="0.195"
        app:layout_constraintHorizontal_bias="0.50"
        android:text="@string/profile_the_password_must_lbl"
        android:textAppearance="@style/subheadings"/>


    <!-- Change Password Text Fields -->
    <!-- Your Current Password Text Field - Editable Text Field -->
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/profile_current_password_layout"
        android:layout_width="300dp"
        android:layout_height="wrap_content"
        android:hint="@string/profile_current_password_lbl"
        android:textColorHint="@color/password_text_grey"
        android:paddingBottom="4dp"
        app:boxBackgroundMode="none"
        app:endIconMode="password_toggle"
        app:endIconTint="@color/grey"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintVertical_bias="0.250"
        app:layout_constraintHorizontal_bias="0.468">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/enter_your_current_password_text"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:background="@drawable/password_underline"
            android:ems="10"
            android:fontFamily="@font/poppins_regular"
            android:inputType="textPassword"
            android:paddingStart="14dp"
            android:textSize="14sp" />
    </com.google.android.material.textfield.TextInputLayout>


    <!-- Your New Password Text Field - Editable Text Field -->
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/profile_new_password_layout"
        android:layout_width="300dp"
        android:layout_height="wrap_content"
        android:hint="@string/profile_new_password_lbl"
        android:textColorHint="@color/password_text_grey"
        android:paddingBottom="4dp"
        app:boxBackgroundMode="none"
        app:endIconMode="password_toggle"
        app:endIconTint="@color/grey"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintVertical_bias="0.310"
        app:layout_constraintHorizontal_bias="0.468">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/enter_your_new_password_text"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:background="@drawable/password_underline"
            android:ems="10"
            android:fontFamily="@font/poppins_regular"
            android:inputType="textPassword"
            android:paddingStart="14dp"
            android:textSize="14sp" />
    </com.google.android.material.textfield.TextInputLayout>


    <!-- Confirm New Password Text Field - Editable Text Field -->
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/profile_confirm_password_layout"
        android:layout_width="300dp"
        android:layout_height="wrap_content"
        android:hint="@string/profile_confirm_password_lbl"
        android:textColorHint="@color/password_text_grey"
        android:paddingBottom="4dp"
        app:boxBackgroundMode="none"
        app:endIconMode="password_toggle"
        app:endIconTint="@color/grey"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintVertical_bias="0.370"
        app:layout_constraintHorizontal_bias="0.468">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/confirm_your_new_password_text"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:background="@drawable/password_underline"
            android:ems="10"
            android:fontFamily="@font/poppins_regular"
            android:inputType="textPassword"
            android:paddingStart="14dp"
            android:textSize="14sp" />
    </com.google.android.material.textfield.TextInputLayout>



    <!-- Password Validations -->
    <!-- Check Icon 1 -->
    <ImageView
        android:id="@+id/check_Icon_1"
        app:srcCompat="@drawable/check_icon"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintVertical_bias="0.435"
        app:layout_constraintHorizontal_bias="0.135" />

    <!-- Subheading - Validation 1 - Characters Required -->
    <TextView
        android:id="@+id/profile_characters_required_lbl"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintVertical_bias="0.435"
        app:layout_constraintHorizontal_bias="0.30"
        android:text="@string/profile_characters_required_lbl"
        android:textAppearance="@style/password_texts"/>


    <!-- Check Icon 2 -->
    <ImageView
        android:id="@+id/check_Icon_2"
        app:srcCompat="@drawable/check_icon"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintVertical_bias="0.470"
        app:layout_constraintHorizontal_bias="0.135" />

    <!-- Subheading - Validation 2 - Number Required -->
    <TextView
        android:id="@+id/profile_number_required_lbl"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintVertical_bias="0.470"
        app:layout_constraintHorizontal_bias="0.27"
        android:text="@string/profile_number_required_lbl"
        android:textAppearance="@style/password_texts"/>


    <!-- Check Icon 3 -->
    <ImageView
        android:id="@+id/check_Icon_3"
        app:srcCompat="@drawable/check_icon"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintVertical_bias="0.505"
        app:layout_constraintHorizontal_bias="0.135" />

    <!-- Subheading - Validation 3 - Required Letter Case -->
    <TextView
        android:id="@+id/profile_required_letter_case_lbl"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintVertical_bias="0.505"
        app:layout_constraintHorizontal_bias="0.45"
        android:text="@string/profile_required_letter_case_lbl"
        android:textAppearance="@style/password_texts"/>



    <!-- Buttons  -->
    <!-- Continue  Button  -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/continue_button"
        android:layout_width="340dp"
        android:layout_height="55dp"
        android:backgroundTint="@color/dark_blue"
        app:cornerRadius="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintVertical_bias="0.825"
        app:layout_constraintHorizontal_bias="0.492"
        android:text="@string/profile_continue_button"
        android:textSize="18sp"
        android:textColor="#FFFFFF"
        android:fontFamily="@font/poppins_regular"
        tools:ignore="MissingConstraints" />

    <!-- Cancel  Button  -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/cancel_button"
        android:layout_width="340dp"
        android:layout_height="55dp"
        android:backgroundTint="@color/white"
        app:cornerRadius="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintVertical_bias="0.890"
        app:layout_constraintHorizontal_bias="0.492"
        android:text="@string/profile_cancel_button"
        android:textSize="18sp"
        android:textColor="@color/brown"
        android:fontFamily="@font/poppins_regular"
        app:strokeColor="@color/light_brown"
        app:strokeWidth="3dp"
        tools:ignore="MissingConstraints" />

</androidx.constraintlayout.widget.ConstraintLayout>