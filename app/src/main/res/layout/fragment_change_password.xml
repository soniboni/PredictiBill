<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ui.profile.ChangePasswordFragment">

    <!-- Logo Image -->
    <ImageView
        android:id="@+id/Logo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="65dp"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/logo_icontext_blue"
        android:contentDescription="@string/logo_content_description"/>

    <!-- Heading - Title -->
    <TextView
        android:id="@+id/profile_change_password_lbl"
        android:layout_width="wrap_content"
        android:layout_height="28dp"
        android:layout_marginTop="15dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/Logo"
        android:text="@string/profile_change_password_lbl"
        android:textAppearance="@style/headings"/>

    <!-- Subheading - The password must be... -->
    <TextView
        android:id="@+id/profile_the_password_must_lbl"
        android:layout_width="wrap_content"
        android:layout_height="20dp"
        android:layout_marginTop="7dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/profile_change_password_lbl"
        android:text="@string/profile_the_password_must_lbl"
        android:textAppearance="@style/subheadings"/>

    <!-- Your Current Password Text Field -->
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/profile_current_password_layout"
        android:layout_width="300dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="15dp"
        android:hint="@string/profile_current_password_lbl"
        android:textColorHint="@color/password_text_grey"
        android:paddingBottom="4dp"
        app:boxBackgroundMode="outline"
        app:boxBackgroundColor="@android:color/white"
        app:endIconMode="password_toggle"
        app:endIconTint="@color/grey"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/profile_the_password_must_lbl">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/enter_your_current_password_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="40dp"
            android:ems="10"
            android:fontFamily="@font/poppins_regular"
            android:inputType="textPassword"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:textSize="14sp"
            android:textColor="@android:color/black" />
    </com.google.android.material.textfield.TextInputLayout>

    <!-- Your New Password Text Field -->
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/profile_new_password_layout"
        android:layout_width="300dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="0dp"
        android:hint="@string/profile_new_password_lbl"
        android:textColorHint="@color/password_text_grey"
        android:paddingBottom="4dp"
        app:boxBackgroundMode="outline"
        app:boxBackgroundColor="@android:color/white"
        app:endIconMode="password_toggle"
        app:endIconTint="@color/grey"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/profile_current_password_layout">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/enter_your_new_password_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="40dp"
            android:ems="10"
            android:fontFamily="@font/poppins_regular"
            android:inputType="textPassword"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:textSize="14sp"
            android:textColor="@color/brown"/>
    </com.google.android.material.textfield.TextInputLayout>

    <!-- Confirm New Password Text Field -->
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/profile_confirm_password_layout"
        android:layout_width="300dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="0dp"
        android:hint="@string/profile_confirm_password_lbl"
        android:textColorHint="@color/password_text_grey"
        android:paddingBottom="4dp"
        app:boxBackgroundMode="outline"
        app:boxBackgroundColor="@android:color/white"
        app:endIconMode="password_toggle"
        app:endIconTint="@color/grey"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/profile_new_password_layout">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/confirm_your_new_password_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="40dp"
            android:ems="10"
            android:fontFamily="@font/poppins_regular"
            android:inputType="textPassword"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:textSize="14sp"
            android:textColor="@color/brown"/>
    </com.google.android.material.textfield.TextInputLayout>

    <!-- Validation 1 Container -->
    <LinearLayout
        android:id="@+id/validation_1_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="15dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        app:layout_constraintStart_toStartOf="@id/profile_confirm_password_layout"
        app:layout_constraintTop_toBottomOf="@id/profile_confirm_password_layout">

        <ImageView
            android:id="@+id/check_Icon_1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            app:srcCompat="@drawable/uncheck_icon"
            android:contentDescription="@string/check_icon_content_description"/>

        <TextView
            android:id="@+id/profile_characters_required_lbl"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/profile_characters_required_lbl"
            android:textAppearance="@style/password_texts"/>
    </LinearLayout>

    <!-- Validation 2 Container -->
    <LinearLayout
        android:id="@+id/validation_2_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        app:layout_constraintStart_toStartOf="@id/validation_1_container"
        app:layout_constraintTop_toBottomOf="@id/validation_1_container">

        <ImageView
            android:id="@+id/check_Icon_2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            app:srcCompat="@drawable/uncheck_icon"
            android:contentDescription="@string/check_icon_content_description"/>

        <TextView
            android:id="@+id/profile_number_required_lbl"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/profile_number_required_lbl"
            android:textAppearance="@style/password_texts"/>
    </LinearLayout>

    <!-- Validation 3 Container -->
    <LinearLayout
        android:id="@+id/validation_3_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        app:layout_constraintStart_toStartOf="@id/validation_2_container"
        app:layout_constraintTop_toBottomOf="@id/validation_2_container">

        <ImageView
            android:id="@+id/check_Icon_3"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            app:srcCompat="@drawable/uncheck_icon"
            android:contentDescription="@string/check_icon_content_description"/>

        <TextView
            android:id="@+id/profile_required_letter_case_lbl"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/profile_required_letter_case_lbl"
            android:textAppearance="@style/password_texts"/>
    </LinearLayout>

    <!-- Continue Button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/profile_continue_button"
        android:layout_width="340dp"
        android:layout_height="55dp"
        android:layout_marginTop="130dp"
        android:backgroundTint="@color/dark_blue"
        app:cornerRadius="0dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/validation_3_container"
        android:text="@string/profile_continue_button"
        android:textSize="18sp"
        android:textColor="#FFFFFF"
        android:fontFamily="@font/poppins_regular"/>

    <!-- Cancel Button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/profile_cancel_button"
        android:layout_width="340dp"
        android:layout_height="55dp"
        android:layout_marginTop="5dp"
        android:backgroundTint="@color/white"
        app:cornerRadius="0dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/profile_continue_button"
        android:text="@string/profile_cancel_button"
        android:textSize="18sp"
        android:textColor="@color/brown"
        android:fontFamily="@font/poppins_regular"
        app:strokeColor="@color/light_brown"
        app:strokeWidth="3dp"/>

</androidx.constraintlayout.widget.ConstraintLayout>
