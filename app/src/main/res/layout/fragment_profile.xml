<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="140dp"
        tools:context=".ui.profile.ProfileFragment">


        <!-- Logo Image -->
        <ImageView
            android:id="@+id/Logo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="183dp"
            android:layout_marginTop="58dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:srcCompat="@drawable/logo_blue"
            android:contentDescription="@string/logo_content_description"/>

        <!-- Main Heading - Profile & Settings Title -->
        <TextView
            android:id="@+id/profile_profile_settings_lbl"
            android:layout_width="220dp"
            android:layout_height="36dp"
            android:layout_marginTop="20dp"
            android:layout_marginStart="32dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/Logo"
            android:text="@string/profile_profile_settings_lbl"
            android:textAppearance="@style/main_heading"/>

        <!-- Subheading -->
        <TextView
            android:id="@+id/manage_your_account"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="0dp"
            android:layout_marginStart="32dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/profile_profile_settings_lbl"
            android:text="@string/profile_manage_your_account_lbl"
            android:textAppearance="@style/main_subheadings"/>

        <!-- User Account Icon Image -->
        <ImageView
            android:id="@+id/imageView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="15dp"
            android:layout_marginStart="32dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/manage_your_account"
            app:srcCompat="@drawable/account_img"
            android:contentDescription="@string/account_image_content_description"/>

        <!-- Account Name -->
        <TextView
            android:id="@+id/profile_account_name_txt"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:layout_marginStart="15dp"
            app:layout_constraintStart_toEndOf="@id/imageView"
            app:layout_constraintTop_toTopOf="@id/imageView"
            android:text="@string/profile_account_name_txt"
            android:textAppearance="@style/account_name"/>

        <!-- Email Account -->
        <TextView
            android:id="@+id/profile_email_account_txt"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="0dp"
            app:layout_constraintStart_toEndOf="@id/imageView"
            app:layout_constraintTop_toBottomOf="@id/profile_account_name_txt"
            android:text="@string/profile_email_account_txt"
            android:textAppearance="@style/email_account"/>

        <!-- Bold Subheadings - Account Settings  -->
        <TextView
            android:id="@+id/profile_account_settings_lbl"
            android:layout_width="wrap_content"
            android:layout_height="24dp"
            android:layout_marginTop="20dp"
            android:layout_marginStart="32dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/imageView"
            android:text="@string/profile_account_settings_lbl"
            android:textAppearance="@style/main_bold_subheadings"/>

        <!-- Change Password Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/profile_change_password_button"
            android:layout_width="0dp"
            android:layout_height="45dp"
            android:layout_marginTop="0dp"
            android:layout_marginStart="32dp"
            android:layout_marginEnd="32dp"
            android:backgroundTint="@color/white"
            app:cornerRadius="0dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/profile_account_settings_lbl"
            android:text="@string/profile_change_password_lbl"
            android:textSize="14sp"
            android:textColor="#383636"
            android:fontFamily="@font/poppins_regular"
            android:gravity="start|center_vertical"
            android:clickable="true"/>

        <!-- Divider Line -->
        <View
            android:id="@+id/divider_1"
            android:layout_width="0dp"
            android:layout_height="1.5dp"
            android:layout_marginStart="32dp"
            android:layout_marginEnd="32dp"
            android:background="@color/stroke_grey"
            app:layout_constraintTop_toBottomOf="@id/profile_change_password_button"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <!-- Bold Subheadings - Notification Settings  -->
        <TextView
            android:id="@+id/profile_notification_settings_lbl"
            android:layout_width="wrap_content"
            android:layout_height="24dp"
            android:layout_marginTop="18dp"
            android:layout_marginStart="32dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/divider_1"
            android:text="@string/profile_notification_settings_lbl"
            android:textAppearance="@style/main_bold_subheadings"/>

        <!-- In-app reminders -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/profile_in_app_reminders_lbl"
            android:layout_width="0dp"
            android:layout_height="45dp"
            android:layout_marginTop="0dp"
            android:layout_marginStart="32dp"
            android:layout_marginEnd="32dp"
            android:backgroundTint="@color/white"
            app:cornerRadius="0dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/profile_notification_settings_lbl"
            android:text="@string/profile_in_app_reminders_lbl"
            android:textSize="14sp"
            android:textColor="#383636"
            android:fontFamily="@font/poppins_regular"
            android:gravity="start|center_vertical"
            android:clickable="false"/>

        <!-- In-app Reminders Toggle Button -->
        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/in_app_reminders_toggle_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="38dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/profile_in_app_reminders_lbl"
            app:layout_constraintBottom_toBottomOf="@id/profile_in_app_reminders_lbl"
            android:checkable="true"
            app:thumbTint="@color/toggle_button_thumb_color"
            app:trackTint="@color/toggle_button_track_color"/>

        <!-- Divider Line -->
        <View
            android:id="@+id/divider_2"
            android:layout_width="0dp"
            android:layout_height="1.5dp"
            android:layout_marginStart="32dp"
            android:layout_marginEnd="32dp"
            android:background="@color/stroke_grey"
            app:layout_constraintTop_toBottomOf="@id/profile_in_app_reminders_lbl"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <!-- Email alerts -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/profile_email_alerts_lbl"
            android:layout_width="0dp"
            android:layout_height="45dp"
            android:layout_marginStart="32dp"
            android:layout_marginEnd="32dp"
            android:backgroundTint="@color/white"
            app:cornerRadius="0dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/divider_2"
            android:text="@string/profile_email_alerts_lbl"
            android:textSize="14sp"
            android:textColor="#383636"
            android:fontFamily="@font/poppins_regular"
            android:gravity="start|center_vertical"
            android:clickable="false"/>

        <!-- Email Alerts Toggle Button -->
        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/email_alerts_toggle_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="38dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/profile_email_alerts_lbl"
            app:layout_constraintBottom_toBottomOf="@id/profile_email_alerts_lbl"
            android:checkable="true"
            app:thumbTint="@color/toggle_button_thumb_color"
            app:trackTint="@color/toggle_button_track_color"/>

        <!-- Divider Line -->
        <View
            android:id="@+id/divider_3"
            android:layout_width="0dp"
            android:layout_height="1.5dp"
            android:layout_marginStart="32dp"
            android:layout_marginEnd="32dp"
            android:background="@color/stroke_grey"
            app:layout_constraintTop_toBottomOf="@id/profile_email_alerts_lbl"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <!-- Bold Subheadings - Preferences  -->
        <TextView
            android:id="@+id/profile_preference_lbl"
            android:layout_width="wrap_content"
            android:layout_height="24dp"
            android:layout_marginTop="18dp"
            android:layout_marginStart="32dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/divider_3"
            android:text="@string/profile_preference_lbl"
            android:textAppearance="@style/main_bold_subheadings"/>

        <!-- Currency Dropdown -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/profile_currency_dropdown"
            android:layout_width="0dp"
            android:layout_height="45dp"
            android:layout_marginTop="0dp"
            android:layout_marginStart="32dp"
            android:layout_marginEnd="32dp"
            android:backgroundTint="@color/white"
            app:cornerRadius="0dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/profile_preference_lbl"
            android:clickable="false"
            android:fontFamily="@font/poppins_regular"
            android:gravity="start|center_vertical"
            android:text="@string/profile_currency_lbl"
            android:textColor="#383636"
            android:textSize="14sp"/>

        <!-- Currency Spinner -->
        <Spinner
            android:id="@+id/currency_spinner"
            android:layout_width="80dp"
            android:layout_height="30dp"
            android:layout_marginEnd="40dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/profile_currency_dropdown"
            app:layout_constraintBottom_toBottomOf="@id/profile_currency_dropdown"
            android:padding="3dp"
            android:background="@drawable/sub_rectangle"
            android:spinnerMode="dropdown"
            android:popupBackground="@drawable/dropdown_popup_bg"
            android:textAppearance="@style/spinner_texts"
            android:textAlignment="gravity"/>

        <!-- Arrow down icon -->
        <ImageView
            android:id="@+id/arrow_down"
            android:layout_width="20dp"
            android:layout_height="25dp"
            android:layout_marginEnd="45dp"
            android:backgroundTint="@color/white"
            android:contentDescription="@string/open_category_content_description"
            android:src="@drawable/arrow_down_icon"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/profile_currency_dropdown"
            app:layout_constraintBottom_toBottomOf="@id/profile_currency_dropdown"/>

        <!-- Divider Line -->
        <View
            android:id="@+id/divider_4"
            android:layout_width="0dp"
            android:layout_height="1.5dp"
            android:layout_marginStart="32dp"
            android:layout_marginEnd="32dp"
            android:background="@color/stroke_grey"
            app:layout_constraintTop_toBottomOf="@id/profile_currency_dropdown"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <!-- Bold Subheadings - About  -->
        <TextView
            android:id="@+id/profile_about_lbl"
            android:layout_width="wrap_content"
            android:layout_height="24dp"
            android:layout_marginTop="18dp"
            android:layout_marginStart="32dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/divider_4"
            android:text="@string/profile_about_lbl"
            android:textAppearance="@style/main_bold_subheadings"/>

        <!-- Help Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/profile_help_button"
            android:layout_width="0dp"
            android:layout_height="45dp"
            android:layout_marginTop="0dp"
            android:layout_marginStart="32dp"
            android:layout_marginEnd="32dp"
            android:backgroundTint="@color/white"
            app:cornerRadius="0dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/profile_about_lbl"
            android:text="@string/profile_help_lbl"
            android:textSize="14sp"
            android:textColor="#383636"
            android:fontFamily="@font/poppins_regular"
            android:gravity="start|center_vertical"
            android:clickable="true"/>

        <!-- Divider Line -->
        <View
            android:id="@+id/divider_5"
            android:layout_width="0dp"
            android:layout_height="1.5dp"
            android:layout_marginStart="32dp"
            android:layout_marginEnd="32dp"
            android:background="@color/stroke_grey"
            app:layout_constraintTop_toBottomOf="@id/profile_help_button"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <!-- Privacy Policy Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/profile_privacy_notice_button"
            android:layout_width="0dp"
            android:layout_height="45dp"
            android:layout_marginStart="32dp"
            android:layout_marginEnd="32dp"
            android:backgroundTint="@color/white"
            app:cornerRadius="0dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/divider_5"
            android:text="@string/profile_privacy_policy_lbl"
            android:textSize="14sp"
            android:textColor="#383636"
            android:fontFamily="@font/poppins_regular"
            android:gravity="start|center_vertical"
            android:clickable="true"/>

        <!-- Divider Line -->
        <View
            android:id="@+id/divider_6"
            android:layout_width="0dp"
            android:layout_height="1.5dp"
            android:layout_marginStart="32dp"
            android:layout_marginEnd="32dp"
            android:background="@color/stroke_grey"
            app:layout_constraintTop_toBottomOf="@id/profile_privacy_notice_button"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <!-- Logout Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/logout_button"
            android:layout_width="0dp"
            android:layout_height="55dp"
            android:layout_marginTop="40dp"
            android:layout_marginStart="32dp"
            android:layout_marginEnd="32dp"
            android:backgroundTint="@color/light_brown"
            app:cornerRadius="0dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/divider_6"
            android:text="@string/profile_logout_lbl"
            android:textSize="18sp"
            android:textColor="@color/white"
            android:fontFamily="@font/poppins_regular"/>

        <!-- Deactivate Account Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/deactivate_account_button"
            android:layout_width="0dp"
            android:layout_height="55dp"
            android:layout_marginTop="5dp"
            android:layout_marginStart="32dp"
            android:layout_marginEnd="32dp"
            android:backgroundTint="@color/white"
            app:cornerRadius="0dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/logout_button"
            android:text="@string/profile_deactivate_account_lbl"
            android:textSize="18sp"
            android:textColor="@color/brown"
            android:fontFamily="@font/poppins_regular"
            app:strokeColor="@color/light_brown"
            app:strokeWidth="3dp"/>

    </androidx.constraintlayout.widget.ConstraintLayout>

</ScrollView>