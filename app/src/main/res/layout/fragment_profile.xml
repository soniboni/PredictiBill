<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ui.profile.ProfileFragment">


    <!-- Logo Image -->
    <ImageView
        android:id="@+id/Logo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="183dp"
        android:layout_marginTop="58dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/logo_blue" />

    <!-- Main Heading - Profile & Settings Title -->
    <TextView
        android:id="@+id/profile_profile_settings_lbl"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintVertical_bias="0.140"
        app:layout_constraintHorizontal_bias="0.126"
        android:text="@string/profile_profile_settings_lbl"
        android:textAppearance="@style/main_heading"/>

    <!-- Subheading -->
    <TextView
        android:id="@+id/manage_your_account"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintVertical_bias="0.175"
        app:layout_constraintHorizontal_bias="0.40"
        android:text="@string/profile_manage_your_account_lbl"
        android:textAppearance="@style/main_subheadings"/>


    <!-- User Account Icon Image -->
    <ImageView
        android:id="@+id/imageView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintVertical_bias="0.235"
        app:layout_constraintHorizontal_bias="0.08"
        app:srcCompat="@drawable/account_img" />

    <!-- Account Name -->
    <TextView
        android:id="@+id/profile_account_name_txt"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintVertical_bias="0.230"
        app:layout_constraintHorizontal_bias="0.470"
        android:text="@string/profile_account_name_txt"
        android:textAppearance="@style/account_name"/>

    <!-- Email Account -->
    <TextView
        android:id="@+id/profile_email_account_txt"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintVertical_bias="0.260"
        app:layout_constraintHorizontal_bias="0.435"
        android:text="@string/profile_email_account_txt"
        android:textAppearance="@style/email_account"/>


    <!-- Bold Subheadings - Account Settings  -->
    <TextView
        android:id="@+id/profile_account_settings_lbl"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintVertical_bias="0.325"
        app:layout_constraintHorizontal_bias="0.13"
        android:text="@string/profile_account_settings_lbl"
        android:textAppearance="@style/main_bold_subheadings"/>

    <!-- IN-PROGRESS: Subheading - Clickable Text/Button  - Change Password  -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/profile_change_password_button"
        android:layout_width="340dp"
        android:layout_height="45dp"
        android:backgroundTint="@color/white"
        app:cornerRadius="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintVertical_bias="0.358"
        app:layout_constraintHorizontal_bias="0.490"
        android:text="@string/profile_change_password_lbl"
        android:textSize="14sp"
        android:textColor="#383636"
        android:fontFamily="@font/poppins_regular"
        android:gravity="start|center_vertical"
        android:clickable="true"
        tools:ignore="MissingConstraints" />

    <!-- Bottom Divider Line -->
    <View
        android:layout_width="340dp"
        android:layout_height="1.5dp"
        android:background="@color/stroke_grey"
        app:layout_constraintTop_toBottomOf="@id/profile_change_password_button"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />


    <!-- Bold Subheadings - Notification Settings  -->
    <TextView
        android:id="@+id/profile_notification_settings_lbl"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintVertical_bias="0.430"
        app:layout_constraintHorizontal_bias="0.14"
        android:text="@string/profile_notification_settings_lbl"
        android:textAppearance="@style/main_bold_subheadings"/>

    <!-- Subheadings - In-app reminders -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/profile_in_app_reminders_lbl"
        android:layout_width="340dp"
        android:layout_height="45dp"
        android:backgroundTint="@color/white"
        app:cornerRadius="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintVertical_bias="0.468"
        app:layout_constraintHorizontal_bias="0.490"
        android:text="@string/profile_in_app_reminders_lbl"
        android:textSize="14sp"
        android:textColor="#383636"
        android:fontFamily="@font/poppins_regular"
        android:gravity="start|center_vertical"
        android:clickable="false"
        tools:ignore="MissingConstraints" />

    <!-- Bottom Divider Line -->
    <View
        android:layout_width="340dp"
        android:layout_height="1.5dp"
        android:background="@color/stroke_grey"
        app:layout_constraintTop_toBottomOf="@id/profile_in_app_reminders_lbl"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- IN-PROGRESS: In-app Reminders Toggle Button -->
    <com.google.android.material.switchmaterial.SwitchMaterial
        android:id="@+id/in_app_reminders_toggle_button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintVertical_bias="0.468"
        app:layout_constraintHorizontal_bias="0.890"
        android:checkable="true"
        app:thumbTint="@color/toggle_button_thumb_color"
        app:trackTint="@color/toggle_button_track_color" />


    <!-- Subheadings - Email alerts -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/profile_email_alerts_lbl"
        android:layout_width="340dp"
        android:layout_height="45dp"
        android:backgroundTint="@color/white"
        app:cornerRadius="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintVertical_bias="0.525"
        app:layout_constraintHorizontal_bias="0.490"
        android:text="@string/profile_email_alerts_lbl"
        android:textSize="14sp"
        android:textColor="#383636"
        android:fontFamily="@font/poppins_regular"
        android:gravity="start|center_vertical"
        android:clickable="false"
        tools:ignore="MissingConstraints" />

    <!-- Bottom Divider Line -->
    <View
        android:layout_width="340dp"
        android:layout_height="1.5dp"
        android:background="@color/stroke_grey"
        app:layout_constraintTop_toBottomOf="@id/profile_email_alerts_lbl"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- IN-PROGRESS: Email Alerts Toggle Button -->
    <com.google.android.material.switchmaterial.SwitchMaterial
        android:id="@+id/email_alerts_toggle_button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintVertical_bias="0.526"
        app:layout_constraintHorizontal_bias="0.890"
        android:checkable="true"
        app:thumbTint="@color/toggle_button_thumb_color"
        app:trackTint="@color/toggle_button_track_color" />


    <!-- Bold Subheadings - Preferences  -->
    <TextView
        android:id="@+id/profile_preference_lbl"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintVertical_bias="0.595"
        app:layout_constraintHorizontal_bias="0.11"
        android:text="@string/profile_preference_lbl"
        android:textAppearance="@style/main_bold_subheadings"/>

    <!-- IN-PROGRESS: Subheadings - Currency (PHP & USD) -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/profile_currency_dropdown"
        android:layout_width="340dp"
        android:layout_height="45dp"
        android:backgroundTint="@color/white"
        app:cornerRadius="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintVertical_bias="0.635"
        app:layout_constraintHorizontal_bias="0.490"
        android:text="@string/profile_currency_lbl"
        android:textSize="14sp"
        android:textColor="#383636"
        android:fontFamily="@font/poppins_regular"
        android:gravity="start|center_vertical"
        android:clickable="false"
        tools:ignore="MissingConstraints" />

    <!-- Bottom Divider Line -->
    <View
        android:layout_width="340dp"
        android:layout_height="1.5dp"
        android:background="@color/stroke_grey"
        app:layout_constraintTop_toBottomOf="@id/profile_currency_dropdown"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Currency Spinner -->
    <Spinner
        android:id="@+id/currency_spinner"
        android:layout_width="95dp"
        android:layout_height="30dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintVertical_bias="0.634"
        app:layout_constraintHorizontal_bias="0.855"
        android:background="@drawable/sub_rectangle"
        android:spinnerMode="dropdown"
        android:textAppearance="@style/spinner_texts"
        android:textAlignment="center"/>
        <!-- android:popupBackground="@drawable/dropdown_popup_bg" -->


    <!-- Bold Subheadings - About  -->
    <TextView
        android:id="@+id/profile_about_lbl"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintVertical_bias="0.705"
        app:layout_constraintHorizontal_bias="0.10"
        android:text="@string/profile_about_lbl"
        android:textAppearance="@style/main_bold_subheadings"/>

    <!-- IN-PROGRESS: Subheading - Clickable Text/Button - Help -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/profile_help_button"
        android:layout_width="340dp"
        android:layout_height="45dp"
        android:backgroundTint="@color/white"
        app:cornerRadius="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintVertical_bias="0.750"
        app:layout_constraintHorizontal_bias="0.490"
        android:text="@string/profile_help_lbl"
        android:textSize="14sp"
        android:textColor="#383636"
        android:fontFamily="@font/poppins_regular"
        android:gravity="start|center_vertical"
        android:clickable="true"
        tools:ignore="MissingConstraints" />

    <!-- Bottom Divider Line -->
    <View
        android:layout_width="340dp"
        android:layout_height="1.5dp"
        android:background="@color/stroke_grey"
        app:layout_constraintTop_toBottomOf="@id/profile_help_button"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />


    <!-- IN-PROGRESS: Subheading - Clickable Text/Button - Privacy Policy -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/profile_privacy_notice_button"
        android:layout_width="340dp"
        android:layout_height="45dp"
        android:backgroundTint="@color/white"
        app:cornerRadius="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintVertical_bias="0.805"
        app:layout_constraintHorizontal_bias="0.490"
        android:text="@string/profile_privacy_policy_lbl"
        android:textSize="14sp"
        android:textColor="#383636"
        android:fontFamily="@font/poppins_regular"
        android:gravity="start|center_vertical"
        android:clickable="true"
        tools:ignore="MissingConstraints" />

    <!-- Bottom Divider Line -->
    <View
        android:layout_width="340dp"
        android:layout_height="1.5dp"
        android:background="@color/stroke_grey"
        app:layout_constraintTop_toBottomOf="@id/profile_privacy_notice_button"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />


    <!-- Buttons  -->
    <!-- IN-PROGRESS: Logout Button  -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/logout_button"
        android:layout_width="340dp"
        android:layout_height="55dp"
        android:backgroundTint="@color/charcoal"
        app:cornerRadius="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintVertical_bias="0.915"
        app:layout_constraintHorizontal_bias="0.492"
        android:text="@string/profile_logout_lbl"
        android:textSize="18sp"
        android:textColor="#FFFFFF"
        android:fontFamily="@font/poppins_regular"
        tools:ignore="MissingConstraints" />

    <!-- IN-PROGRESS: Deactivate Account Button  -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/deactivate_account_button"
        android:layout_width="340dp"
        android:layout_height="55dp"
        android:backgroundTint="@color/white"
        app:cornerRadius="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintVertical_bias="0.980"
        app:layout_constraintHorizontal_bias="0.492"
        android:text="@string/profile_deactivate_account_lbl"
        android:textSize="18sp"
        android:textColor="@color/brown"
        android:fontFamily="@font/poppins_regular"
        app:strokeColor="@color/charcoal"
        app:strokeWidth="3dp"
        tools:ignore="MissingConstraints" />

</androidx.constraintlayout.widget.ConstraintLayout>