<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    tools:context=".ui.subscriptions.SubscriptionsFragment">

    <!-- Logo Image -->
    <ImageView
        android:id="@+id/logo_image"
        android:layout_width="35dp"
        android:layout_height="37dp"
        android:layout_marginTop="56dp"
        android:src="@drawable/logo_blue"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/subscriptio"
        android:layout_width="0dp"
        android:layout_height="40dp"
        android:layout_marginTop="32dp"
        android:layout_marginStart="25dp"
        android:layout_marginEnd="25dp"
        android:gravity="center_vertical"
        android:text="@string/subscriptio"
        android:textAppearance="@style/subscriptio"
        app:layout_constraintTop_toBottomOf="@id/logo_image"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/track_all_r"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="0dp"
        android:layout_marginStart="27dp"
        android:layout_marginEnd="25dp"
        android:text="@string/track_all_r"
        android:textAppearance="@style/track_all_r"
        app:layout_constraintTop_toBottomOf="@id/subscriptio"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/filter_by"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginStart="25dp"
        android:layout_marginEnd="25dp"
        android:text="@string/filter_by"
        android:textAppearance="@style/filter_by"
        app:layout_constraintTop_toBottomOf="@id/track_all_r"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- RecyclerView for Subscriptions -->

    <com.google.android.material.chip.ChipGroup
        android:id="@+id/filter_chip_group"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="center"
        app:layout_constraintTop_toBottomOf="@id/filter_by"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.5"
        app:singleSelection="true"
        app:selectionRequired="false"
        app:chipSpacingHorizontal="12dp"
        app:singleLine="true">

        <com.google.android.material.chip.Chip
            android:id="@+id/chip_method"
            android:layout_width="112dp"
            android:layout_height="55dp"
            android:backgroundTint="@color/white"
            android:checkable="true"
            android:checked="false"
            android:text="Category"
            android:textAlignment="center"
            android:textAppearance="@style/track_all_r"
            android:textColor="@color/black"
            app:chipCornerRadius="50dp" />

        <com.google.android.material.chip.Chip
            android:id="@+id/chip_category"
            android:layout_width="112dp"
            android:layout_height="55dp"
            android:backgroundTint="@color/white"
            android:checkable="true"
            android:checked="false"
            android:text="Status"
            android:textAlignment="center"
            android:textAppearance="@style/track_all_r"
            android:textColor="@color/black"
            app:chipCornerRadius="50dp" />

        <com.google.android.material.chip.Chip
            android:id="@+id/chip_billing_cycle"
            android:layout_width="120dp"
            android:layout_height="55dp"
            android:backgroundTint="@color/white"
            android:checkable="true"
            android:checked="false"
            android:text="Billing Cycle"
            android:textAlignment="center"
            android:textAppearance="@style/track_all_r"
            android:textColor="@color/black"
            app:chipCornerRadius="50dp" />

    </com.google.android.material.chip.ChipGroup>




    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/subscription_recycler_view"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:padding="8dp"
        app:layout_constraintBottom_toTopOf="@+id/submit_button"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/filter_chip_group"
        app:layout_constraintVertical_bias="0.0" />
    <Button
        android:id="@+id/submit_button"
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:layout_margin="16dp"
        android:background="@drawable/round_button"
        android:textColor="@color/white"
        android:text="+"
        android:textSize="24sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
