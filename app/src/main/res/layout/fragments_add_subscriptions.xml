<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/white"
        android:fillViewport="true"
        tools:layout_editor_absoluteX="99dp"
        tools:layout_editor_absoluteY="-49dp">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <!-- Logo Image -->
            <ImageView
                android:id="@+id/logo_image"
                android:layout_width="35dp"
                android:layout_height="37dp"
                android:layout_marginTop="56dp"
                android:src="@drawable/logo_blue"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <ImageButton
                android:id="@+id/back_button"
                android:layout_width="53dp"
                android:layout_height="53dp"
                android:layout_marginStart="24dp"
                android:layout_marginTop="110dp"
                android:background="@drawable/back_button_bg"
                android:contentDescription="Back"
                android:src="@drawable/back_button"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/add_a_subsc"
                android:layout_width="244dp"
                android:layout_height="45dp"
                android:layout_marginStart="89dp"
                android:layout_marginTop="114dp"
                android:gravity="center_vertical"
                android:lineSpacingExtra="2sp"
                android:text="@string/add_subscription"
                android:textAppearance="@style/subscriptio"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <androidx.cardview.widget.CardView
                android:id="@+id/imageUploadCard"
                android:layout_width="330dp"
                android:layout_height="122dp"
                android:layout_marginTop="192dp"
                android:autofillHints="Upload an Image"
                android:backgroundTint="@color/white"
                app:cardCornerRadius="8dp"
                app:cardElevation="2dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.493"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <!-- Add your CardView content here -->

            </androidx.cardview.widget.CardView>

            <TextView
                android:id="@+id/subscription_id"
                android:layout_width="115dp"
                android:layout_height="16dp"
                android:layout_alignParentLeft="true"
                android:layout_alignParentTop="true"
                android:layout_marginTop="328dp"
                android:gravity="center_vertical"
                android:lineSpacingExtra="19sp"
                android:text="Subscription ID"
                android:textAppearance="@style/subscription_id"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.135"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/subscription_id_number"
                android:layout_width="117dp"
                android:layout_height="18dp"
                android:layout_alignParentLeft="true"
                android:layout_alignParentTop="true"
                android:layout_marginTop="12dp"
                android:gravity="right|center_vertical"
                android:hint="ID number"
                android:lineSpacingExtra="16sp"
                android:textAppearance="@style/subscription_id"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.705"
                app:layout_constraintStart_toEndOf="@+id/subscription_id"
                app:layout_constraintTop_toBottomOf="@+id/imageUploadCard" />

            <!--Name of Subscription-->

            <TextView
                android:id="@+id/name"
                android:layout_width="64dp"
                android:layout_height="24dp"
                android:layout_alignParentLeft="true"
                android:layout_alignParentTop="true"
                android:gravity="center_vertical"
                android:lineSpacingExtra="16sp"
                android:text="@string/name"
                android:textAppearance="@style/name"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.115"
                app:layout_constraintStart_toStartOf="parent"
                tools:layout_editor_absoluteY="353dp" />

            <EditText
                android:id="@+id/subscription_name_input"
                android:layout_width="346dp"
                android:layout_height="39dp"
                android:layout_alignParentLeft="true"
                android:layout_alignParentTop="true"
                android:background="@drawable/sub_rectangle"
                android:inputType="textCapWords"
                android:paddingStart="12dp"
                android:textColorHint="#999999"
                android:textSize="14sp"
                tools:layout_editor_absoluteX="44dp"
                tools:layout_editor_absoluteY="381dp" />

            <!-- Note-->

            <EditText
                android:id="@+id/subscription_note_input"
                android:layout_width="346dp"
                android:layout_height="109dp"
                android:layout_alignParentLeft="true"
                android:layout_alignParentTop="true"
                android:layout_marginTop="16dp"
                android:background="@drawable/sub_rectangle"
                android:inputType="textCapWords"
                android:paddingStart="12dp"
                android:textColorHint="#999999"
                android:textSize="14sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.37"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/note" />

            <TextView
                android:id="@+id/note"
                android:layout_width="64dp"
                android:layout_height="24dp"
                android:layout_alignParentLeft="true"
                android:layout_alignParentTop="true"
                android:gravity="center_vertical"
                android:lineSpacingExtra="16sp"
                android:text="@string/note"
                android:textAppearance="@style/note"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.115"
                app:layout_constraintStart_toStartOf="parent"
                tools:layout_editor_absoluteY="440dp" />

            <!--Category-->

            <TextView
                android:id="@+id/category"
                android:layout_width="74dp"
                android:layout_height="23dp"
                android:layout_alignParentLeft="true"
                android:layout_alignParentTop="true"
                android:layout_marginTop="20dp"
                android:gravity="center_vertical"
                android:lineSpacingExtra="16sp"
                android:text="@string/category"
                android:textAppearance="@style/category_1.2"
                app:layout_constraintEnd_toStartOf="@+id/status"
                app:layout_constraintHorizontal_bias="0.29"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/subscription_note_input" />

            <Spinner
                android:id="@+id/subscription_category_spinner"
                android:layout_width="167dp"
                android:layout_height="42dp"
                android:layout_marginTop="4dp"
                android:background="@drawable/sub_rectangle"
                android:padding="10dp"
                android:spinnerMode="dropdown"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.151"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/category" />


            <!--Status-->
            <TextView
                android:id="@+id/status"
                android:layout_width="74dp"
                android:layout_height="23dp"
                android:layout_alignParentLeft="true"
                android:layout_alignParentTop="true"
                android:layout_marginTop="28dp"
                android:layout_marginEnd="152dp"
                android:gravity="center_vertical"
                android:lineSpacingExtra="16sp"
                android:text="@string/status"
                android:textAppearance="@style/category_1.2"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/subscription_note_input" />

            <Spinner
                android:id="@+id/subscription_status_spinner"
                android:layout_width="174dp"
                android:layout_height="42dp"
                android:layout_marginTop="4dp"
                android:background="@drawable/sub_rectangle"
                android:padding="10dp"
                android:spinnerMode="dropdown"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.795"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/status" />

            <!--Billing Cycle-->
            <TextView
                android:id="@+id/billing_cycle"
                android:layout_width="124dp"
                android:layout_height="20dp"
                android:layout_alignParentLeft="true"
                android:layout_alignParentTop="true"
                android:layout_marginTop="12dp"
                android:gravity="center_vertical"
                android:lineSpacingExtra="16sp"
                android:text="@string/billing_cyc"
                android:textAppearance="@style/category_1.2"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.128"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/subscription_category_spinner" />

            <Spinner
                android:id="@+id/billing_cycle_spinner"
                android:layout_width="345dp"
                android:layout_height="41dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/sub_rectangle"
                android:padding="10dp"
                android:spinnerMode="dropdown"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.408"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/billing_cycle" />


            <!--AddSubscription Button-->



        </androidx.constraintlayout.widget.ConstraintLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>