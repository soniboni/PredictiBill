<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/white"
        android:paddingBottom="24dp">

        <!-- Logo Image -->
        <ImageView
            android:id="@+id/logo_image"
            android:layout_width="0dp"
            android:layout_height="37dp"
            android:src="@drawable/logo_blue"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_bias="0.072" />

        <!-- Image Upload Card -->
        <ImageButton
            android:id="@+id/back_button"
            android:layout_width="53dp"
            android:layout_height="53dp"
            android:layout_marginStart="36dp"
            android:layout_marginTop="20dp"
            android:background="@drawable/back_button_bg"
            android:contentDescription="Back"
            android:src="@drawable/back_button"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/logo_image" />

        <TextView
            android:id="@+id/add_a_subsc"
            android:layout_width="244dp"
            android:layout_height="45dp"
            android:layout_marginTop="28dp"
            android:layout_marginEnd="60dp"
            android:gravity="center_vertical"
            android:lineSpacingExtra="2sp"
            android:text="@string/add_subscription"
            android:textAppearance="@style/subscriptio"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/logo_image" />

        <androidx.cardview.widget.CardView
            android:id="@+id/imageUploadCard"
            android:layout_width="330dp"
            android:layout_height="122dp"
            android:autofillHints="Upload an Image"
            android:backgroundTint="@color/white"
            app:cardCornerRadius="8dp"
            app:cardElevation="2dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/back_button"
            android:layout_marginTop="16dp">

            <!-- Add your CardView content here -->
        </androidx.cardview.widget.CardView>

        <!-- Subscription ID Section -->
        <TextView
            android:id="@+id/subscription_id"
            android:layout_width="115dp"
            android:layout_height="16dp"
            android:gravity="center_vertical"
            android:lineSpacingExtra="19sp"
            android:text="@string/subscription_id"
            android:textAppearance="@style/subscription_id"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/imageUploadCard"
            android:layout_marginStart="16dp"
            android:layout_marginTop="16dp"/>

        <!-- to be changed when database is connected(this is auto incremented)-->
        <TextView
            android:id="@+id/subscription_id_number"
            android:layout_width="117dp"
            android:layout_height="18dp"
            android:gravity="right|center_vertical"
            android:hint="ID number"
            android:lineSpacingExtra="16sp"
            android:textAppearance="@style/subscription_id"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/imageUploadCard"
            android:layout_marginEnd="16dp"
            android:layout_marginTop="16dp"/>

        <!-- Name Section -->
        <TextView
            android:id="@+id/name"
            android:layout_width="64dp"
            android:layout_height="24dp"
            android:gravity="center_vertical"
            android:lineSpacingExtra="16sp"
            android:text="@string/name"
            android:textAppearance="@style/name"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/subscription_id"
            android:layout_marginStart="16dp"
            android:layout_marginTop="24dp"/>

        <EditText
            android:id="@+id/subscription_name_input"
            android:layout_width="0dp"
            android:layout_height="39dp"
            android:background="@drawable/sub_rectangle"
            android:inputType="textCapWords"
            android:paddingStart="12dp"
            android:textColorHint="#999999"
            android:textSize="14sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/name"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginTop="8dp"/>

        <!-- Note Section -->
        <TextView
            android:id="@+id/note"
            android:layout_width="64dp"
            android:layout_height="24dp"
            android:gravity="center_vertical"
            android:lineSpacingExtra="16sp"
            android:text="@string/note"
            android:textAppearance="@style/note"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/subscription_name_input"
            android:layout_marginStart="16dp"
            android:layout_marginTop="24dp"/>

        <EditText
            android:id="@+id/subscription_note_input"
            android:layout_width="0dp"
            android:layout_height="109dp"
            android:background="@drawable/sub_rectangle"
            android:inputType="textCapWords"
            android:paddingStart="12dp"
            android:textColorHint="@color/black"
            android:gravity="top|start"
            android:textSize="14sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/note"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginTop="8dp"/>

        <!-- Category and Status Section -->

        <TextView
            android:id="@+id/category"
            android:layout_width="74dp"
            android:layout_height="23dp"
            android:layout_marginStart="20dp"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:lineSpacingExtra="16sp"
            android:text="@string/category"
            android:textAppearance="@style/category_1"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/subscription_note_input" />

        <TextView
            android:id="@+id/status"
            android:layout_width="74dp"
            android:layout_height="23dp"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="120dp"
            android:gravity="center_vertical"
            android:lineSpacingExtra="16sp"
            android:text="@string/status"
            android:textAppearance="@style/category_1"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/subscription_note_input" />

        <Spinner
            android:id="@+id/subscription_category_spinner"
            android:layout_width="177dp"
            android:layout_height="44dp"
            android:layout_marginStart="16dp"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/sub_rectangle"
            android:padding="10dp"
            android:popupBackground="@drawable/dropdown_popup_bg"
            android:spinnerMode="dropdown"
            app:layout_constraintEnd_toStartOf="@+id/status"
            app:layout_constraintHorizontal_bias="0.0"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/category" />

        <!-- Billing Cycle Section -->
        <Spinner
            android:id="@+id/subscription_status_spinner"
            android:layout_width="174dp"
            android:layout_height="45dp"
            android:layout_marginStart="8dp"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="16dp"
            android:background="@drawable/sub_rectangle"
            android:padding="10dp"
            android:popupBackground="@drawable/dropdown_popup_bg"
            android:spinnerMode="dropdown"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.0"
            app:layout_constraintStart_toEndOf="@+id/subscription_category_spinner"
            app:layout_constraintTop_toBottomOf="@+id/status" />

        <TextView
            android:id="@+id/billing_cycle"
            android:layout_width="129dp"
            android:layout_height="33dp"
            android:gravity="center_vertical"
            android:lineSpacingExtra="16sp"
            android:text="@string/billing_cyc"
            android:textAppearance="@style/category_1"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/subscription_category_spinner"
            android:layout_marginStart="16dp"
            android:layout_marginTop="20dp"/>

        <!-- Date Section -->


        <Spinner
            android:id="@+id/billing_cycle_spinner"
            android:layout_width="0dp"
            android:layout_height="43dp"
            android:layout_marginStart="16dp"
            android:layout_marginTop="4dp"
            android:layout_marginEnd="16dp"
            android:background="@drawable/sub_rectangle"
            android:popupBackground="@drawable/dropdown_popup_bg"
            android:spinnerMode="dropdown"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="1.0"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/billing_cycle" />

        <TextView
            android:id="@+id/start_date_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="24dp"
            android:text="@string/startdate"
            android:textAppearance="@style/category_1"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/billing_cycle_spinner" />

        <LinearLayout
            android:id="@+id/start_date_container"
            android:layout_width="178dp"
            android:layout_height="41dp"
            android:layout_marginStart="14dp"
            android:layout_marginTop="4dp"
            android:background="@drawable/sub_rectangle"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            app:layout_constraintEnd_toStartOf="@+id/next_billing_date_container"
            app:layout_constraintHorizontal_bias="0.0"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/start_date_label">

            <ImageView
                android:layout_width="38dp"
                android:layout_height="match_parent"
                android:layout_gravity="end"
                android:layout_marginStart="8dp"
                android:contentDescription="Open date picker"
                android:src="@drawable/date_picker_logo" />

            <TextView
                android:id="@+id/start_date_display"
                android:layout_width="125dp"
                android:layout_height="20dp"
                android:textColor="#999999"
                android:textSize="14sp" />

        </LinearLayout>

        <!--Next Billing Date-->


        <TextView
            android:id="@+id/next_billing_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="204dp"
            android:layout_marginTop="24dp"
            android:text="@string/nextbillingdate"
            android:textAppearance="@style/category_1"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/billing_cycle_spinner" />

        <LinearLayout
            android:id="@+id/next_billing_date_container"
            android:layout_width="178dp"
            android:layout_height="41dp"
            android:layout_marginTop="4dp"
            android:layout_marginEnd="28dp"
            android:background="@drawable/sub_rectangle"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            app:layout_constraintEnd_toEndOf="parent"

            app:layout_constraintTop_toBottomOf="@+id/next_billing_label">

            <ImageView
                android:layout_width="38dp"
                android:layout_height="match_parent"
                android:layout_gravity="end"
                android:layout_marginStart="8dp"
                android:contentDescription="Open date picker"
                android:src="@drawable/date_picker_logo" />

            <TextView
                android:id="@+id/next_billing_date_display"
                android:layout_width="125dp"
                android:layout_height="20dp"
                android:textColor="@color/black"
                android:textSize="14sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/price_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/price"
            android:textAppearance="@style/category_1"
            app:layout_constraintBottom_toBottomOf="parent"

            app:layout_constraintEnd_toStartOf="@+id/payment_method_label"
            app:layout_constraintHorizontal_bias="0.095"

            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/start_date_container"
            app:layout_constraintVertical_bias="0.141" />

        <EditText
            android:id="@+id/price_input"
            android:layout_width="173dp"
            android:layout_height="40dp"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:background="@drawable/sub_rectangle"
            android:inputType="textCapWords"
            android:paddingStart="12dp"
            android:textColorHint="@color/black"
            android:textSize="14sp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.0"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/price_label"
            app:layout_constraintVertical_bias="0.144" />

        <TextView
            android:id="@+id/payment_method_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/payment_method"
            android:textAppearance="@style/category_1"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.75"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/next_billing_date_container"
            app:layout_constraintVertical_bias="0.141" />

        <Spinner
            android:id="@+id/payment_method_spinner"
            android:layout_width="172dp"
            android:layout_height="39dp"
            android:layout_marginEnd="20dp"
            android:background="@drawable/sub_rectangle"
            android:padding="10dp"
            android:popupBackground="@drawable/dropdown_popup_bg"
            android:spinnerMode="dropdown"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="1.0"
            app:layout_constraintStart_toEndOf="@+id/price_input"
            app:layout_constraintTop_toBottomOf="@+id/payment_method_label"
            app:layout_constraintVertical_bias="0.142" />

        <Button
            android:id="@+id/add_sub_button"
            android:layout_width="361dp"
            android:layout_height="51dp"
            android:layout_marginTop="28dp"
            android:background="@drawable/sub_rectangle"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.657"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/price_input" />

        <TextView
            android:layout_width="166dp"
            android:layout_height="30dp"
            android:layout_marginStart="104dp"
            android:layout_marginBottom="12dp"
            android:text="@string/add_subscription"
            android:textAppearance="@style/add_sub_button"
            app:layout_constraintBottom_toBottomOf="@+id/add_sub_button"
            app:layout_constraintStart_toStartOf="@+id/add_sub_button"
            app:layout_constraintTop_toTopOf="@+id/add_sub_button"
            app:layout_constraintVertical_bias="1.0" />


    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>