<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white">

    <!-- Logo Image -->

    <ImageView
        android:id="@+id/logo_image"
        android:layout_width="0dp"
        android:layout_height="37dp"
        android:src="@drawable/logo_blue"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.072" />

    <ImageButton
        android:id="@+id/back_button"
        android:layout_width="53dp"
        android:layout_height="53dp"
        android:background="@drawable/back_button_bg"
        android:contentDescription="Back"
        android:src="@drawable/back_button"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.067"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.148" />

    <TextView
        android:id="@+id/add_a_subsc"
        android:layout_width="244dp"
        android:layout_height="45dp"
        android:gravity="center_vertical"
        android:lineSpacingExtra="2sp"
        android:text="@string/add_subscription"
        android:textAppearance="@style/subscriptio"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.684"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.148" />

    <!--Name of Subscription-->
    <androidx.cardview.widget.CardView
        android:id="@+id/imageUploadCard"
        android:layout_width="330dp"
        android:layout_height="122dp"
        android:autofillHints="Upload an Image"
        android:backgroundTint="@color/white"
        app:cardCornerRadius="8dp"
        app:cardElevation="2dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.492"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.273">

        <!-- Add your CardView content here -->

    </androidx.cardview.widget.CardView>

    <TextView
        android:id="@+id/subscription_id"
        android:layout_width="115dp"
        android:layout_height="16dp"
        android:gravity="center_vertical"
        android:lineSpacingExtra="19sp"
        android:text="Subscription ID"
        android:textAppearance="@style/subscription_id"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.111"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.41" />

    <!-- Note-->

    <TextView
        android:id="@+id/subscription_id_number"
        android:layout_width="117dp"
        android:layout_height="18dp"
        android:layout_marginTop="12dp"
        android:gravity="right|center_vertical"
        android:hint="ID number"
        android:lineSpacingExtra="16sp"
        android:textAppearance="@style/subscription_id"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.753"
        app:layout_constraintStart_toEndOf="@+id/subscription_id"
        app:layout_constraintTop_toBottomOf="@+id/imageUploadCard"
        app:layout_constraintVertical_bias="0.0" />

    <TextView
        android:id="@+id/name"
        android:layout_width="64dp"
        android:layout_height="24dp"
        android:gravity="center_vertical"
        android:lineSpacingExtra="16sp"
        android:text="@string/name"
        android:textAppearance="@style/name"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.094"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/subscription_id_number"
        app:layout_constraintVertical_bias="0.029" />

    <!--Category-->

    <EditText
        android:id="@+id/subscription_name_input"
        android:layout_width="346dp"
        android:layout_height="39dp"
        android:background="@drawable/sub_rectangle"
        android:inputType="textCapWords"
        android:paddingStart="12dp"
        android:textColorHint="#999999"
        android:textSize="14sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.659"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/name"
        app:layout_constraintVertical_bias="0.005" />

    <TextView
        android:id="@+id/note"
        android:layout_width="64dp"
        android:layout_height="24dp"
        android:layout_marginTop="24dp"
        android:gravity="center_vertical"
        android:lineSpacingExtra="16sp"
        android:text="@string/note"
        android:textAppearance="@style/note"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.094"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/subscription_name_input"
        app:layout_constraintVertical_bias="0.0" />

    <!--Status-->

    <!--Billing Cycle-->

    <EditText
        android:id="@+id/subscription_note_input"
        android:layout_width="346dp"
        android:layout_height="109dp"
        android:background="@drawable/sub_rectangle"
        android:inputType="textCapWords"
        android:paddingStart="12dp"
        android:textColorHint="#999999"
        android:textSize="14sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.574"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.699" />

    <TextView
        android:id="@+id/category"
        android:layout_width="74dp"
        android:layout_height="23dp"
        android:layout_marginTop="20dp"
        android:gravity="center_vertical"
        android:lineSpacingExtra="16sp"
        android:text="@string/category"
        android:textAppearance="@style/category_1"
        app:layout_constraintEnd_toStartOf="@+id/status"
        app:layout_constraintHorizontal_bias="0.217"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/subscription_note_input" />

    <Spinner
        android:id="@+id/subscription_category_spinner"
        android:layout_width="167dp"
        android:layout_height="42dp"
        android:layout_marginTop="4dp"
        android:background="@drawable/sub_rectangle"
        android:padding="10dp"
        android:spinnerMode="dropdown"
        android:popupBackground="@drawable/dropdown_popup_bg"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.123"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/category" />


    <TextView
        android:id="@+id/status"
        android:layout_width="74dp"
        android:layout_height="23dp"
        android:layout_marginTop="20dp"
        android:layout_marginEnd="116dp"
        android:gravity="center_vertical"
        android:lineSpacingExtra="16sp"
        android:text="@string/status"
        android:textAppearance="@style/category_1"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/subscription_note_input" />

    <Spinner
        android:id="@+id/subscription_status_spinner"
        android:layout_width="174dp"
        android:layout_height="42dp"
        android:layout_marginTop="4dp"
        android:background="@drawable/sub_rectangle"
        android:padding="10dp"
        android:spinnerMode="dropdown"
        android:popupBackground="@drawable/dropdown_popup_bg"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.926"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/status" />

    <TextView
        android:id="@+id/billing_cycle"
        android:layout_width="129dp"
        android:layout_height="33dp"
        android:layout_marginTop="8dp"
        android:gravity="center_vertical"
        android:lineSpacingExtra="16sp"
        android:text="@string/billing_cyc"
        android:textAppearance="@style/category_1"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.106"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/subscription_category_spinner" />

    <Spinner
        android:id="@+id/billing_cycle_spinner"
        android:layout_width="348dp"
        android:layout_height="43dp"
        android:background="@drawable/sub_rectangle"
        android:popupBackground="@drawable/dropdown_popup_bg"
        android:spinnerMode="dropdown"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.622"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.97" />

    <TextView
        android:id="@+id/start_date_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Start Date"
        android:textAppearance="@style/category_1"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.087"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="1.0" />

    <!-- DatePicker for Start Date -->
</androidx.constraintlayout.widget.ConstraintLayout>