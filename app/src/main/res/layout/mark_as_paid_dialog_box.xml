<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="290dp"
    android:layout_height="210dp"
    app:cardElevation="10dp"
    app:cardCornerRadius="16dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <ImageView
            android:id="@+id/image_view_question_mark"
            android:layout_width="23dp"
            android:layout_height="27dp"
            android:layout_marginTop="25dp"
            android:contentDescription="@string/image_view_question_mark"
            android:src="@drawable/dialog_box_questionmark"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/mark_subs_as_paid_lbl"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/mark_subs_as_paid_lbl"
            android:textAppearance="@style/dialog_box_markaspaid"
            app:layout_constraintEnd_toEndOf="@+id/image_view_question_mark"
            app:layout_constraintStart_toStartOf="@+id/image_view_question_mark"
            app:layout_constraintTop_toBottomOf="@+id/image_view_question_mark" />

        <TextView
            android:id="@+id/mark_subs_as_paid_note"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="24dp"
            android:layout_marginTop="5dp"
            android:layout_marginEnd="24dp"
            android:gravity="center"
            android:text="@string/mark_subs_as_paid_note"
            android:textAppearance="@style/dialog_box_markaspaidnote"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/mark_subs_as_paid_lbl" />

        <LinearLayout
            android:id="@+id/button_layout"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:layout_marginStart="24dp"
            android:layout_marginEnd="24dp"
            android:layout_marginBottom="20dp"
            android:orientation="horizontal"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/mark_subs_as_paid_note">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/cancel_btn"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:backgroundTint="@color/white"
                android:fontFamily="@font/poppins_light"
                android:text="@string/cancel_btn"
                android:textColor="@color/brown"
                android:textSize="12sp"
                app:cornerRadius="5dp"
                app:strokeColor="@color/light_brown"
                app:strokeWidth="2dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/confirm_btn"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:backgroundTint="@color/dark_blue"
                android:fontFamily="@font/poppins_light"
                android:text="@string/confirm_btn"
                android:textColor="@color/white"
                android:textSize="12sp"
                app:cornerRadius="5dp" />

        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.cardview.widget.CardView>