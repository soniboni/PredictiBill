    <!-- Profile & Settings / Help -->
    <!-- Heading -->
    <string name="profile_welcome_to_lbl">Welcome to PredictiBill Help!</string>
    <string name="profile_heres_a_quick_lbl">Here\'s a quick guide to get you started:</string>

    <!-- What does PredictiBill do? -->
    <string name="profile_what_does_predictibill_lbl">What does PredictiBill do?</string>
    <string name="profile_predictibill_helps_you_txt">
        PredictiBill helps you track, organize, and manage \nall your recurring subscriptions in one place. You’ll
        \nget timely reminders before upcoming charges \nand gain insights into your spending habits.</string>

    <!-- Common Questions -->
    <string name="profile_common_questions_lbl">Common Questions</string>

    <!-- Question 1 - Q: Can I cancel subscriptions through the app? -->
    <string name="profile_question_1_lbl">Q: Can I cancel subscriptions through the app?</string>
    <!-- Answer to Question 1 -->
    <string name="profile_answer_1_txt">
        A: No. PredictiBill is a tracking tool only. You can
        \nmark subscriptions and see details, but
        \ncancellations must be done via the provider\'s
        \nplatform (e.g., Netflix, Spotify).</string>

    <!-- Question 2 - Q: How do I add a subscription? -->
    <string name="profile_question_2_lbl">Q: How do I add a subscription?</string>
    <!-- Answer to Question 1 -->
    <string name="profile_answer_2_txt">
        A: Go to the Subscriptions tab and tap Add
        \nSubscription. Fill in the name, price, category, and
        \nbilling cycle.</string>

    <!-- Q: Will I get reminders?-->
    <string name="profile_question_3_lbl">Q: Will I get reminders?</string>
    <!-- Answer to Question 3 -->
    <string name="profile_answer_3_txt">
        A: Yes! PredictiBill sends alerts for upcoming billing
        \ndates if notifications are enabled in your settings.</string>


