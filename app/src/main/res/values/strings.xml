    <string name="profile_welcome_to_lbl">Welcome to PredictiBill Help!</string>
    <string name="profile_heres_a_quick_lbl">Here\'s a quick guide to get you started:</string>

    <string name="profile_what_does_predictibill_lbl">What does PredictiBill do?</string>
    <string name="profile_predictibill_helps_you_txt">
        PredictiBill helps you track, organize, and manage all your recurring subscriptions in one place.
        You’ll get timely reminders before upcoming charges and gain insights into your spending habits.</string>

    <string name="profile_common_questions_lbl">Common Questions</string>
    <string name="profile_question_1_lbl">Q: Can I cancel subscriptions through the app?</string>
    <string name="profile_answer_1_txt">
        A: No. PredictiBill is a tracking tool only. You can mark subscriptions and see details,
        but cancellations must be done via the provider\'s platform (e.g., Netflix, Spotify).</string>

    <string name="profile_question_2_lbl">Q: How do I add a subscription?</string>
    <string name="profile_answer_2_txt">
        A: Go to the Subscriptions tab and tap Add Subscription. Fill in the name, price, category, and billing cycle.</string>

    <string name="profile_question_3_lbl">Q: Will I get reminders?</string>
    <string name="profile_answer_3_txt">
        A: Yes! PredictiBill sends alerts for upcoming billing dates if notifications are enabled in your settings.</string>

