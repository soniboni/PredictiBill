<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.MyApp" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Splash screen background color -->
        <item name="android:windowSplashScreenBackground">#000564</item>

        <!-- Your logo -->
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/opening_logo</item>

        <!-- Optional: Duration of animation -->
        <item name="android:windowSplashScreenAnimationDuration">500</item>

        <!-- Optional: Exit animation -->
        <item name="android:windowSplashScreenExitAnimation">@anim/splash_exit</item>
    </style>
</resources>